# Copy this file to .env and fill in real values. Never commit the real .env.
# (A real .env with a working TMDB_API_KEY already ships with this project --
# this file just documents the format / is the template if you rotate the key.)

# TMDB API key (v3 auth) -- https://www.themoviedb.org/settings/api
# Optional: the app runs fully without one, using cached metadata (if any)
# and graceful fallback cards instead of posters/backdrops.
TMDB_API_KEY=

# For Streamlit Cloud deployments, put TMDB_API_KEY in
# .streamlit/secrets.toml instead of (or in addition to) this file:
#   TMDB_API_KEY = "your-key-here"
